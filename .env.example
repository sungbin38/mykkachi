NEXT_PUBLIC_SITE_URL=https://mykkachi.com
# Neon PostgreSQL. Server only: never prefix these keys with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
PGHOST=
PGDATABASE=neondb
PGUSER=
PGPASSWORD=
NEON_PROJECT_ID=
# Generate hash with scripts/admin-password.mjs; use a separate random session secret.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Optional: extra IPs to drop from visitor statistics (comma-separated). 112.161.16.159 is always excluded.
TRACK_EXCLUDE_IPS=
# Bank transfer details shown to customers after booking (public by nature).
NEXT_PUBLIC_BANK_NAME=하나은행
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_HOLDER=
# Optional: new-booking emails via Resend (https://resend.com). NOTIFY_EMAIL gets the owner alert.
RESEND_API_KEY=
NOTIFY_EMAIL=
FROM_EMAIL=MY KKACHI <onboarding@resend.dev>
# Optional: where customer replies go (defaults to NOTIFY_EMAIL)
REPLY_TO_EMAIL=

# Resend email.received signature verification. Forward target is fixed to the owner.
RESEND_WEBHOOK_SECRET=
